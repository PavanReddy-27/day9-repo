{
  "info": {
    "name": "Workforce Analytics API",
    "description": "Postman collection for the Workforce Analytics backend endpoints including Auth, Attendance, Geofencing, Shifts, Corrections, and Audit Logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Attendance & Geofencing",
      "item": [
        {
          "name": "Get Attendance Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "status"]
            }
          }
        },
        {
          "name": "Check In (Geofenced)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": {\n    \"latitude\": 17.3850,\n    \"longitude\": 78.4867,\n    \"accuracy\": 15\n  },\n  \"shiftType\": \"Regular\",\n  \"workMode\": \"Office\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/check-in",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "check-in"]
            }
          }
        },
        {
          "name": "Start Break",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/break/start",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "break", "start"]
            }
          }
        },
        {
          "name": "Resume Work",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/break/resume",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "break", "resume"]
            }
          }
        },
        {
          "name": "Check Out",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": {\n    \"latitude\": 17.3850,\n    \"longitude\": 78.4867\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/check-out",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "check-out"]
            }
          }
        },
        {
          "name": "Global Attendance Roster",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/global",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "global"]
            }
          }
        }
      ]
    },
    {
      "name": "Corrections",
      "item": [
        {
          "name": "Create Correction Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-08-21\",\n  \"requestedCheckIn\": \"2026-08-21T09:00:00Z\",\n  \"requestedCheckOut\": \"2026-08-21T17:00:00Z\",\n  \"reason\": \"Forgot to check out due to system update\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/corrections",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "corrections"]
            }
          }
        },
        {
          "name": "Get Correction Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/corrections",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "corrections"]
            }
          }
        },
        {
          "name": "Approve Correction",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comments\": \"Approved by manager\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/attendance/corrections/:id/approve",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "attendance", "corrections", ":id", "approve"]
            }
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/audit-logs?page=1&limit=50",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "audit-logs"]
            }
          }
        }
      ]
    }
  ]
}
