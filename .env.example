# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/workforce_analytics

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# JWT Security
JWT_SECRET=supersecret_jwt_access_key_change_in_production_32char
JWT_REFRESH_SECRET=supersecret_jwt_refresh_key_change_in_production_32char
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Geofence Default Radius (Meters)
DEFAULT_GEOFENCE_RADIUS=500

# Client Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
